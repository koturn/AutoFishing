<Window x:Class="AutoFishing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nud="clr-namespace:NumericUpDownLib;assembly=NumericUpDownLib"
        xmlns:local="clr-namespace:AutoFishing"
        mc:Ignorable="d"
        Title="Auto Fishing" Width="Auto" Height="Auto"
        SizeToContent="WidthAndHeight" Closing="Window_Closing" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid Margin="6,6,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="AUto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Content="Charge time:" Grid.Row="0" Grid.Column="0" Margin="3,3,3,3" VerticalContentAlignment="Center"/>
        <nud:UIntegerUpDown Value="500" MinValue="100" MaxValue="3000" IsReadOnly="False" IsMouseDragEnabled="False" IsUpdateValueWhenLostFocus="True" Background="White" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Margin="3,3,3,3" ValueChanged="NudChargeTime_ValueChanged"/>
        <Label Content="ms" Grid.Row="0" Grid.Column="5" Margin="3,3,3,3" VerticalContentAlignment="Center"/>

        <Label Content="Wait timeout:" Grid.Row="1" Grid.Column="0" Margin="3,3,3,3" VerticalContentAlignment="Center"/>
        <nud:UIntegerUpDown Value="90000" MinValue="10000" MaxValue="300000" IsReadOnly="False" IsMouseDragEnabled="False" IsUpdateValueWhenLostFocus="True" Background="White" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="3,3,3,3" ValueChanged="NudWaitTimeout_ValueChanged"/>
        <Label Content="ms" Grid.Row="1" Grid.Column="5" Margin="3,3,3,3" VerticalContentAlignment="Center"/>

        <Label Content="Roll timeout:" Grid.Row="2" Grid.Column="0" Margin="3,3,3,3" VerticalContentAlignment="Center"/>
        <nud:UIntegerUpDown Value="20000" MinValue="10000" MaxValue="30000" IsReadOnly="False" IsMouseDragEnabled="False" IsUpdateValueWhenLostFocus="True" Background="White" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="3,3,3,3" ValueChanged="NudRollTimeout_ValueChanged"/>
        <Label Content="ms" Grid.Row="2" Grid.Column="5" Margin="3,3,3,3" VerticalContentAlignment="Center"/>

        <Label Content="Hot Key:" Grid.Row="3" Grid.Column="0" Margin="3,3,3,3" VerticalContentAlignment="Center"/>
        <CheckBox x:Name="_checkBoxShift" Content="Shift" Grid.Row="3" Grid.Column="1" Margin="3,3,3,3" VerticalContentAlignment="Center" Checked="CheckBoxModifierKey_Checked" Unchecked="CheckBoxModifierKey_Unchecked"/>
        <CheckBox x:Name="_checkBoxCtrl" Content="Ctrl" Grid.Row="3" Grid.Column="2" Margin="3,3,3,3" VerticalContentAlignment="Center" Checked="CheckBoxModifierKey_Checked" Unchecked="CheckBoxModifierKey_Unchecked"/>
        <CheckBox x:Name="_checkBoxAlt" Content="Alt" Grid.Row="3" Grid.Column="3" Margin="3,3,3,3" VerticalContentAlignment="Center" Checked="CheckBoxModifierKey_Checked" Unchecked="CheckBoxModifierKey_Unchecked"/>
        <ComboBox x:Name="_comboBoxHotKey" SelectedIndex="47" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" Margin="3,3,3,3" VerticalContentAlignment="Center" SelectionChanged="ComboBoxHotKey_SelectionChanged">
            <ComboBoxItem>0</ComboBoxItem>
            <ComboBoxItem>1</ComboBoxItem>
            <ComboBoxItem>2</ComboBoxItem>
            <ComboBoxItem>3</ComboBoxItem>
            <ComboBoxItem>4</ComboBoxItem>
            <ComboBoxItem>5</ComboBoxItem>
            <ComboBoxItem>6</ComboBoxItem>
            <ComboBoxItem>7</ComboBoxItem>
            <ComboBoxItem>8</ComboBoxItem>
            <ComboBoxItem>9</ComboBoxItem>
            <ComboBoxItem>A</ComboBoxItem>
            <ComboBoxItem>B</ComboBoxItem>
            <ComboBoxItem>C</ComboBoxItem>
            <ComboBoxItem>D</ComboBoxItem>
            <ComboBoxItem>E</ComboBoxItem>
            <ComboBoxItem>F</ComboBoxItem>
            <ComboBoxItem>G</ComboBoxItem>
            <ComboBoxItem>H</ComboBoxItem>
            <ComboBoxItem>I</ComboBoxItem>
            <ComboBoxItem>J</ComboBoxItem>
            <ComboBoxItem>K</ComboBoxItem>
            <ComboBoxItem>L</ComboBoxItem>
            <ComboBoxItem>M</ComboBoxItem>
            <ComboBoxItem>N</ComboBoxItem>
            <ComboBoxItem>O</ComboBoxItem>
            <ComboBoxItem>P</ComboBoxItem>
            <ComboBoxItem>Q</ComboBoxItem>
            <ComboBoxItem>R</ComboBoxItem>
            <ComboBoxItem>S</ComboBoxItem>
            <ComboBoxItem>T</ComboBoxItem>
            <ComboBoxItem>U</ComboBoxItem>
            <ComboBoxItem>V</ComboBoxItem>
            <ComboBoxItem>W</ComboBoxItem>
            <ComboBoxItem>X</ComboBoxItem>
            <ComboBoxItem>Y</ComboBoxItem>
            <ComboBoxItem>Z</ComboBoxItem>
            <ComboBoxItem>F0</ComboBoxItem>
            <ComboBoxItem>F1</ComboBoxItem>
            <ComboBoxItem>F2</ComboBoxItem>
            <ComboBoxItem>F3</ComboBoxItem>
            <ComboBoxItem>F4</ComboBoxItem>
            <ComboBoxItem>F5</ComboBoxItem>
            <ComboBoxItem>F6</ComboBoxItem>
            <ComboBoxItem>F7</ComboBoxItem>
            <ComboBoxItem>F8</ComboBoxItem>
            <ComboBoxItem>F9</ComboBoxItem>
            <ComboBoxItem>F10</ComboBoxItem>
            <ComboBoxItem>F11</ComboBoxItem>
            <ComboBoxItem>F12</ComboBoxItem>
        </ComboBox>

        <Label Content="Host:" Grid.Row="4" Grid.Column="0" Margin="3,3,3,3" VerticalContentAlignment="Center"/>
        <TextBox x:Name="_textBoxHost" Text="127.0.0.1" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Margin="3,3,3,3" VerticalContentAlignment="Center"/>

        <Label Content="Port:" Grid.Row="5" Grid.Column="0" Margin="3,3,3,3" VerticalContentAlignment="Center"/>
        <nud:UShortUpDown x:Name="_nudPort" Value="9000" MinValue="0" MaxValue="65535" IsReadOnly="False" IsMouseDragEnabled="False" IsUpdateValueWhenLostFocus="True" Background="White" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" Margin="3,3,3,0" VerticalContentAlignment="Center" />

        <Label Content="Input interval" Grid.Row="6" Grid.Column="0" Margin="3,3,3,3" VerticalContentAlignment="Center"/>
        <nud:UShortUpDown x:Name="_nudInputInterval" Value="33" MinValue="16" MaxValue="200" IsReadOnly="False" IsMouseDragEnabled="False" IsUpdateValueWhenLostFocus="True" Background="White" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" Margin="3,3,3,0" VerticalContentAlignment="Center" ValueChanged="NudInputInterval_ValueChanged"/>
        <Label Content="ms" Grid.Row="6" Grid.Column="6" Margin="3,3,3,3" VerticalContentAlignment="Center"/>

        <Label Content="Log Watch Cycle" Grid.Row="7" Grid.Column="0" Margin="3,3,3,3" VerticalContentAlignment="Center"/>
        <nud:UShortUpDown x:Name="_nudWatchCycle" Value="1000" MinValue="500" MaxValue="2000" IsReadOnly="False" IsMouseDragEnabled="False" IsUpdateValueWhenLostFocus="True" Background="White" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="4" Margin="3,3,3,0" VerticalContentAlignment="Center" ValueChanged="NudWatchCycle_ValueChanged" />
        <Label Content="ms" Grid.Row="7" Grid.Column="5" Margin="3,3,3,3" VerticalContentAlignment="Center"/>

        <Button x:Name="_buttonStartStop" Content="Start" Grid.Row="8" Grid.Column="0" Margin="3,3,3,3" Click="ButtonToggle_Click"/>
        <Label x:Name="_labelStatus" Content="Stop" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5" Margin="3,3,3,3" VerticalContentAlignment="Center"/>

        <Label Content="Current World:" Grid.Row="9" Grid.Column="0" Margin="3,3,3,3" VerticalContentAlignment="Center"/>
        <Label x:Name="_labelCurrentWorld" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="5" Margin="3,3,3,3" VerticalContentAlignment="Center"/>
    </Grid>
</Window>
